{
  "name": "dealflow360",
  "version": "1.0.0",
  "description": "Intelligent, Self-Governing Sales Operations Platform",
  "main": "server/src/app.js",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
